digraph erd {
  layout=neato; overlap=false; splines=true; sep="+18"; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, style="filled", color="#1F4E79"];
  edge [color="#8D99AE", fontname="Helvetica", fontsize=8];
  dim_date [label="Date", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_territory [label="Territory", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_product [label="Product", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_customer [label="Customer", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_salesperson [label="Salesperson", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_employee [label="Employee", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_department [label="Department", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_vendor [label="Vendor", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_special_offer [label="Special Offer", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_ship_method [label="Ship Method", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  dim_location [label="Location", shape=box, style="rounded,filled", fillcolor="#DCEBF7"];
  fact_sales_line [label="Sales\n(one row per sales order line)", shape=box, fillcolor="#FBD9A6"];
  fact_sales_quota [label="Quota\n(one row per salesperson per month)", shape=box, fillcolor="#FBD9A6"];
  fact_purchase_line [label="Purchases\n(one row per purchase order line)", shape=box, fillcolor="#FBD9A6"];
  fact_inventory [label="Inventory\n(one row per product per location)", shape=box, fillcolor="#FBD9A6"];
  fact_headcount_monthly [label="Headcount\n(one row per employee per month-end)", shape=box, fillcolor="#FBD9A6"];
  fact_payroll_monthly [label="Payroll\n(one row per department x territory x month-end)", shape=box, fillcolor="#FBD9A6"];
  fact_sales_line -> dim_date [arrowhead=normal, style=solid, label=""];
  fact_sales_line -> dim_date [arrowhead=normal, style=dashed, label="Ship Date"];
  fact_sales_line -> dim_date [arrowhead=normal, style=dashed, label="Due Date"];
  fact_sales_line -> dim_customer [arrowhead=normal, style=solid, label=""];
  fact_sales_line -> dim_product [arrowhead=normal, style=solid, label=""];
  fact_sales_line -> dim_territory [arrowhead=normal, style=solid, label=""];
  fact_sales_line -> dim_salesperson [arrowhead=normal, style=solid, label=""];
  fact_sales_line -> dim_special_offer [arrowhead=normal, style=solid, label=""];
  fact_sales_line -> dim_ship_method [arrowhead=normal, style=solid, label=""];
  fact_sales_quota -> dim_date [arrowhead=normal, style=solid, label=""];
  fact_sales_quota -> dim_salesperson [arrowhead=normal, style=solid, label=""];
  fact_sales_quota -> dim_territory [arrowhead=normal, style=solid, label=""];
  fact_purchase_line -> dim_date [arrowhead=normal, style=solid, label=""];
  fact_purchase_line -> dim_date [arrowhead=normal, style=dashed, label="Ship Date"];
  fact_purchase_line -> dim_date [arrowhead=normal, style=dashed, label="Due Date"];
  fact_purchase_line -> dim_vendor [arrowhead=normal, style=solid, label=""];
  fact_purchase_line -> dim_product [arrowhead=normal, style=solid, label=""];
  fact_purchase_line -> dim_ship_method [arrowhead=normal, style=solid, label=""];
  fact_purchase_line -> dim_territory [arrowhead=normal, style=solid, label=""];
  fact_inventory -> dim_product [arrowhead=normal, style=solid, label=""];
  fact_inventory -> dim_location [arrowhead=normal, style=solid, label=""];
  fact_headcount_monthly -> dim_date [arrowhead=normal, style=solid, label=""];
  fact_headcount_monthly -> dim_employee [arrowhead=normal, style=solid, label=""];
  fact_headcount_monthly -> dim_department [arrowhead=normal, style=solid, label=""];
  fact_headcount_monthly -> dim_territory [arrowhead=normal, style=solid, label=""];
  fact_payroll_monthly -> dim_date [arrowhead=normal, style=solid, label=""];
  fact_payroll_monthly -> dim_department [arrowhead=normal, style=solid, label=""];
  fact_payroll_monthly -> dim_territory [arrowhead=normal, style=solid, label=""];
  dim_employee -> dim_territory [arrowhead=normal, style=dotted, label=""];
  dim_vendor -> dim_territory [arrowhead=normal, style=dotted, label=""];
}