{
  "name": "Enterprise BI Suite",
  "dataColors": ["#1F4E79", "#2E86AB", "#F18F01", "#6B9080", "#C73E1D", "#7D5BA6", "#8D99AE", "#3B1F2B"],
  "background": "#FFFFFF", "foreground": "#252423", "tableAccent": "#1F4E79",
  "good": "#2E7D32", "neutral": "#F9A825", "bad": "#C62828",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F4E79" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#444444" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F4E79" }
  },
  "visualStyles": {
    "*": { "*": {
      "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F4E79" } }, "fontSize": 11, "bold": true }],
      "border": [{ "show": true, "color": { "solid": { "color": "#E1E5EA" } }, "radius": 4 }],
      "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }]
    } },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }] } }
  }
}
