# ---- which warehouse the Python steps and dbt talk to ----
C360_TARGET=duckdb                 # duckdb (local demo)  |  bigquery (real GA4 sample)
C360_DUCKDB_PATH=data/c360.duckdb

# ---- BigQuery settings (only needed when C360_TARGET=bigquery) ----
GCP_PROJECT=your-gcp-project-id
BQ_LOCATION=US                     # MUST be US: the GA4 public sample lives in the US multi-region
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json   # or run: gcloud auth application-default login

# ---- dataset / schema names (same names are used for DuckDB schemas) ----
C360_RAW_SCHEMA=c360_raw
C360_ML_SCHEMA=c360_ml
C360_TRUTH_SCHEMA=c360_truth
C360_DBT_SCHEMA=c360               # dbt writes c360_staging, c360_intermediate, c360_marts

# ---- Segment (optional, only for scripts/segment_replay.py) ----
SEGMENT_WRITE_KEY=
